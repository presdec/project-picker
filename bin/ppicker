#!/usr/bin/env zsh
# ppicker - Project Picker CLI
# Provides: init, doctor, --help, --version
# Works standalone; pairs with project-picker.plugin.zsh
set -eu
set -o pipefail 2>/dev/null || true
# Hard-disable tracing/verbose within this script to avoid leaking debug traces from user env
unsetopt xtrace 2>/dev/null || true
unsetopt verbose 2>/dev/null || true
set +x +v 2>/dev/null || true

# ----------------------------- Constants --------------------------------------
VERSION="1.0.0-beta"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/project-picker"
CONFIG_FILE="${CONFIG_DIR}/config.toml"

# Defaults for [global]
DEFAULT_CACHE_TTL_MIN=10
DEFAULT_EDITOR="code"         # code|codium|idea|cursor|windsurf|nvim|vim|custom:/path
DEFAULT_PREVIEW="tree"        # tree|none
DEFAULT_DEPTH=1
DEFAULT_EXCLUDES=("node_modules" ".git")
DEFAULT_INCLUDE_WS="false"

# ----------------------------- Helpers ----------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }
err()  { print -r -- "ppicker: $*" >&2; }
note() { print -r -- "$*"; }
die()  { err "$*"; exit 1; }
cmd_path() { command -v "$1" 2>/dev/null; }
fd_cmd() {
  if have fd; then
    print -r -- "fd"
  elif have fdfind; then
    print -r -- "fdfind"
  else
    return 1
  fi
}

expand_path() {
  # Expand ~ and vars, keep as-is if not resolvable (no existence check)
  local p="$1"
  # Support $/path as shorthand for $HOME/path
  if [[ "$p" == '$/'* ]]; then
    p="$HOME/${p#$/}"
  fi
  eval "print -r -- ${p:q}" 2>/dev/null
}

yesno() {
  # yesno "Prompt" default_yes|default_no
  local prompt="$1" def="${2:-default_yes}" ans
  local hint="[Y/n]"; [[ "$def" = "default_no" ]] && hint="[y/N]"
  printf "%s %s " "$prompt" "$hint"
  read -r ans
  if [[ -z "$ans" ]]; then
    [[ "$def" = "default_yes" ]] && return 0 || return 1
  fi
  [[ "$ans" = [Yy] || "$ans" = yes ]]
}

ask() {
  # ask "Prompt" "default"
  local prompt="$1" def="${2:-}"
  local prompt="$1" def="$2"
  local ans
  if [[ -n "$def" ]]; then
    ans="$def"
    vared -p "$prompt [$def]: " -c ans
  else
    vared -p "$prompt: " -c ans
  fi
  REPLY="$ans"
  # Echo the answer for backward-compat command substitution users
  print -r -- "$ans"
  return 0
}

# ask_var var_name "Prompt" "default"
ask_var() {
  local __var="$1"; shift
  local prompt="$1"; shift
  local def="${1:-}"
  local val
  if [[ -n "$def" ]]; then
    val="$def"
    vared -p "$prompt [$def]: " -c val
  else
    vared -p "$prompt: " -c val
  fi
  typeset -g "${__var}=$val" >/dev/null 2>&1
}

ask_var_default_on_empty() {
  local __var="$1"; shift
  local prompt="$1"; shift
  local def="${1:-}"
  local val=""
  vared -p "$prompt [$def]: " -c val
  [[ -z "$val" ]] && val="$def"
  typeset -g "${__var}=$val" >/dev/null 2>&1
}

select_one() {
  # select_one "Prompt" item1 item2 ... -> echoes selection or empty
  local prompt="$1"; shift
  local -a items; items=("$@")
  if (( ${#items[@]} == 0 )); then print -r -- ""; return; fi
  if have fzf; then
    printf '%s\n' "${items[@]}" | fzf --prompt="${prompt} > "
  else
    note "$prompt"
    local i=1; for it in "${items[@]}"; do printf '%2d) %s\n' $i "$it"; ((i++)); done
    printf "Select number (q to cancel): "; local n; read -r n
    [[ "$n" == "q" || -z "$n" ]] && { print -r -- ""; return; }
    if [[ "$n" -ge 1 && "$n" -le ${#items[@]} ]]; then
      print -r -- "${items[$n]}"
    else
      print -r -- ""
    fi
  fi
}

# select_one_var var_name "Prompt" item1 item2 ... (zsh vared-compatible)
select_one_var() {
  local __var="$1"; shift
  local prompt="$1"; shift
  local -a items; items=("$@")
  local choice=""
  # Suppress trace/verbose within this helper to avoid noisy var assignments
  setopt localoptions typesetsilent
  unsetopt xtrace verbose
  if (( ${#items[@]} == 0 )); then
    typeset -g "${__var}=" >/dev/null 2>&1
    return 0
  fi
  if have fzf; then
    choice=$(printf '%s\n' "${items[@]}" | fzf --prompt="${prompt} > ")
  else
    note "$prompt"
    local i=1; for it in "${items[@]}"; do printf '%2d) %s\n' $i "$it"; ((i++)); done
    local n=""
    vared -p "Select number (q to cancel): " -c n
    if [[ "$n" == q || -z "$n" ]]; then
      choice=""
    elif [[ "$n" -ge 1 && "$n" -le ${#items[@]} ]]; then
      choice="${items[$n]}"
    fi
  fi
  typeset -g "${__var}=$choice" >/dev/null 2>&1
}

editor_menu() {
  local -a opts=("code" "codium" "idea" "cursor" "windsurf" "nvim" "vim" "custom:/absolute/path/to/editor")
  local sel; sel=$(select_one "Default editor" "${opts[@]}")
  [[ -z "$sel" ]] && sel="$DEFAULT_EDITOR"
  print -r -- "$sel"
}

_pp_strip_toml_comment() {
  local line="$1" result="" char
  local -i in_quote=0 i=0 n=${#line}
  while (( i < n )); do
    char="${line:$i:1}"
    if (( in_quote )); then
      if [[ "$char" == '\' ]] && (( i + 1 < n )) && [[ "${line:$((i+1)):1}" == '"' ]]; then
        result+='\"'; (( i += 2 )); continue
      fi
      [[ "$char" == '"' ]] && in_quote=0
      result+="$char"
    else
      if [[ "$char" == '"' ]]; then in_quote=1; result+="$char"
      elif [[ "$char" == '#' ]]; then break
      else result+="$char"
      fi
    fi
    (( i++ ))
  done
  print -r -- "$result"
}

_pp_parse_toml_array() {
  local raw="$1" current="" char
  local -i in_dq=0 in_sq=0 i=0 n=${#raw}
  while (( i < n )); do
    char="${raw:$i:1}"
    if (( in_dq )); then
      if [[ "$char" == '\' ]] && (( i + 1 < n )) && [[ "${raw:$((i+1)):1}" == '"' ]]; then
        current+='"'; (( i += 2 )); continue
      fi
      if [[ "$char" == '"' ]]; then in_dq=0; else current+="$char"; fi
    elif (( in_sq )); then
      if [[ "$char" == "'" ]]; then in_sq=0; else current+="$char"; fi
    else
      if [[ "$char" == '"' ]]; then in_dq=1
      elif [[ "$char" == "'" ]]; then in_sq=1
      elif [[ "$char" == ',' ]]; then
        local _t="${current## }"; _t="${_t%% }"
        [[ -n "$_t" ]] && print -r -- "$_t"
        current=""
      else current+="$char"
      fi
    fi
    (( i++ ))
  done
  local _t="${current## }"; _t="${_t%% }"
  [[ -n "$_t" ]] && print -r -- "$_t"
}

_pp_unquote_toml() {
  local v="$1"
  v="${v## }"; v="${v%% }"
  if [[ "$v" == '"'*'"' ]]; then
    v="${v#\"}"; v="${v%\"}"; v="${v//\\\"/\"}"
  elif [[ "$v" == "'"*"'" ]]; then
    v="${v#\'}"; v="${v%\'}"
  fi
  print -r -- "$v"
}

normalize_key() {
  local k="$1"
  k="${k//[^a-zA-Z0-9]/}"   # only [a-zA-Z0-9]
  k="${k:l}"                # lowercase
  print -r -- "$k"
}

array_to_toml() {
  # array_to_toml arr[@] -> TOML array literal
  local -a arr; arr=("${(@P)1}")
  local first=1 out="["
  for it in "${arr[@]}"; do
    local s="${it//\"/\\\"}"
    if (( first )); then out+="\"$s\""; first=0
    else out+=", \"$s\""
    fi
  done
  out+="]"
  print -r -- "$out"
}

exclude_preset_values() {
  local preset="${1:l}"
  preset="${preset//[[:space:]]/}"
  reply=()
  case "$preset" in
    1|default|base)
      reply=("${DEFAULT_EXCLUDES[@]}")
      ;;
    2|web|js|javascript|ts|typescript|node|frontend)
      reply=("node_modules" "dist" "build" "coverage" ".next" ".nuxt" ".svelte-kit" ".turbo" ".vite")
      ;;
    3|python|py)
      reply=(".venv" "venv" "env" "__pycache__" ".pytest_cache" ".mypy_cache" ".ruff_cache" "dist" "build")
      ;;
    4|rust|rs)
      reply=("target")
      ;;
    5|jvm|java|kotlin|gradle|maven)
      reply=("target" "build" "out" ".gradle")
      ;;
    6|go|golang)
      reply=("bin" "vendor")
      ;;
    7|dotnet|.net|csharp|c#)
      reply=("bin" "obj")
      ;;
    8|ruby|rb|rails)
      reply=("vendor/bundle" "tmp" "log" "coverage")
      ;;
    9|php|composer|laravel)
      reply=("vendor" "var/cache" "public/build")
      ;;
    10|cpp|c++|c|cmake)
      reply=("build" "cmake-build-debug" "cmake-build-release" "CMakeFiles")
      ;;
    11|elixir|ex)
      reply=("_build" "deps")
      ;;
    12|dart|flutter)
      reply=("build" ".dart_tool")
      ;;
    13|swift|ios)
      reply=(".build" "DerivedData")
      ;;
    14|mobile|reactnative|react-native)
      reply=("android/.gradle" "ios/Pods")
      ;;
    all|common)
      local -a names=(default web python rust jvm go dotnet ruby php cpp elixir dart swift mobile)
      local -a all_values=()
      local name
      for name in "${names[@]}"; do
        exclude_preset_values "$name"
        all_values+=("${reply[@]}")
      done
      reply=("${all_values[@]}")
      ;;
    *)
      return 1
      ;;
  esac
}

choose_excludes() {
  local default_preset="${1:-default}"
  reply=()
  print -r -- "Exclude presets (comma-separated; blank keeps suggested/default):"
  print -r -- "  1) default: node_modules, .git"
  print -r -- "  2) web/js/ts: node_modules, dist, build, coverage, .next, .nuxt, .svelte-kit, .turbo, .vite"
  print -r -- "  3) python: .venv, venv, env, __pycache__, .pytest_cache, .mypy_cache, .ruff_cache, dist, build"
  print -r -- "  4) rust: target"
  print -r -- "  5) jvm: target, build, out, .gradle"
  print -r -- "  6) go: bin, vendor"
  print -r -- "  7) dotnet: bin, obj"
  print -r -- "  8) ruby: vendor/bundle, tmp, log, coverage"
  print -r -- "  9) php: vendor, var/cache, public/build"
  print -r -- "  10) cpp: build, cmake-build-debug, cmake-build-release, CMakeFiles"
  print -r -- "  11) elixir: _build, deps"
  print -r -- "  12) dart/flutter: build, .dart_tool"
  print -r -- "  13) swift/ios: .build, DerivedData"
  print -r -- "  14) mobile/react-native: android/.gradle, ios/Pods"
  print -r -- "  all) all common presets"
  print -r -- "  none) no excludes"
  print -r -- "  custom) prompt for custom comma-separated excludes"

  local preset_input
  ask_var_default_on_empty preset_input "Exclude presets" "$default_preset"
  [[ -z "$preset_input" ]] && preset_input="$default_preset"

  local -a tokens selected custom_items
  local token wants_custom=0
  IFS=',' read -rA tokens <<< "$preset_input"
  for token in "${tokens[@]}"; do
    token="${token##[[:space:]]}"
    token="${token%%[[:space:]]}"
    [[ -z "$token" ]] && continue
    case "${token:l}" in
      none)
        reply=("__PPICKER_EXCLUDES_NONE__")
        return 0
        ;;
      custom)
        wants_custom=1
        ;;
      *)
        if exclude_preset_values "$token"; then
          selected+=("${reply[@]}")
        else
          selected+=("$token")
        fi
        ;;
    esac
  done

  if (( wants_custom )); then
    local custom_excludes
    ask_var custom_excludes "Custom excludes (comma-separated)" ""
    if [[ -n "$custom_excludes" ]]; then
      IFS=',' read -rA custom_items <<< "$custom_excludes"
      selected+=("${custom_items[@]}")
    fi
  fi

  local -A seen
  local item
  reply=()
  for item in "${selected[@]}"; do
    item="${item##[[:space:]]}"
    item="${item%%[[:space:]]}"
    [[ -z "$item" || ${+seen[$item]} -ne 0 ]] && continue
    seen[$item]=1
    reply+=("$item")
  done
}

detect_exclude_presets() {
  emulate -L zsh
  setopt null_glob
  local root="$1"
  local max_depth="${2:-3}"
  local max_dirs="${3:-500}"
  reply=()
  [[ -d "$root" ]] || return 0

  local -A found
  local -a dirs next_dirs children
  dirs=("$root")
  local depth dir child name scanned=0

  for (( depth=0; depth<=max_depth && ${#dirs[@]} > 0; depth++ )); do
    next_dirs=()
    for dir in "${dirs[@]}"; do
      (( scanned++ ))
      (( scanned > max_dirs )) && break 2

      [[ -e "$dir/package.json" || -e "$dir/pnpm-lock.yaml" || -e "$dir/yarn.lock" || -e "$dir/bun.lockb" ]] && found[web]=1
      [[ -e "$dir/pyproject.toml" || -e "$dir/requirements.txt" || -e "$dir/setup.py" || -e "$dir/uv.lock" ]] && found[python]=1
      [[ -e "$dir/Cargo.toml" ]] && found[rust]=1
      [[ -e "$dir/go.mod" ]] && found[go]=1
      [[ -e "$dir/pom.xml" || -e "$dir/build.gradle" || -e "$dir/build.gradle.kts" || -e "$dir/settings.gradle" || -e "$dir/settings.gradle.kts" ]] && found[jvm]=1
      local -a dotnet_markers
      dotnet_markers=("$dir"/*.csproj(N) "$dir"/*.sln(N))
      (( ${#dotnet_markers[@]} )) && found[dotnet]=1
      [[ -e "$dir/Gemfile" ]] && found[ruby]=1
      [[ -e "$dir/composer.json" ]] && found[php]=1
      [[ -e "$dir/CMakeLists.txt" ]] && found[cpp]=1
      [[ -e "$dir/mix.exs" ]] && found[elixir]=1
      [[ -e "$dir/pubspec.yaml" ]] && found[dart]=1
      [[ -e "$dir/Package.swift" ]] && found[swift]=1
      [[ -e "$dir/android/build.gradle" || -e "$dir/android/build.gradle.kts" || -d "$dir/ios/Pods" ]] && found[mobile]=1

      (( depth == max_depth )) && continue
      children=("$dir"/*(N/))
      for child in "${children[@]}"; do
        name="${child:t}"
        case "$name" in
          .git|node_modules|target|build|dist|coverage|.venv|venv|env|__pycache__|.gradle|vendor|Pods|.dart_tool|.next|.nuxt|.svelte-kit|.turbo)
            continue
            ;;
        esac
        next_dirs+=("$child")
      done
    done
    dirs=("${next_dirs[@]}")
  done

  local -a order=(web python rust jvm go dotnet ruby php cpp elixir dart swift mobile)
  local preset
  for preset in "${order[@]}"; do
    (( ${+found[$preset]} )) && reply+=("$preset")
  done
}

exists_dir_or_ws() { [[ -d "$1" || "$1" == *.code-workspace && -f "$1" ]]; }

suggest_paths() {
  # Populate suggestions based on common dev folders (existing only)
  local -a suggestions=()
  local -a candidates=(
    "$HOME/work" "$HOME/mywork"
    "$HOME/dev" "$HOME/dev/*"
    "$HOME/projects" "$HOME/code"
    "$HOME/dev/rust" "$HOME/dev/ts" "$HOME/dev/typescript"
    "$HOME/templates/ts" "$HOME/scratch" "$HOME/src"
  )
  local c
  for c in "${candidates[@]}"; do
    for p in ${(f)"$(eval print -r -- $c 2>/dev/null)"}; do
      [[ -d "$p" ]] && suggestions+="$p"
    done
  done
  print -r -- "${(u)suggestions[@]}"  # unique
}

validate_key_unique() {
  local k="$1"; shift
  local -a keys; keys=("${(@P)1}")
  for x in "${keys[@]}"; do [[ "$x" == "$k" ]] && return 1; done
  return 0
}

is_positive_integer() {
  local n="$1"
  [[ "$n" == <-> && "$n" -gt 0 ]]
}

is_reserved_scope_key() {
  local k="$1"
  case "$k" in
    config|doctor|reload|help|init|version|h) return 0 ;;
    *) return 1 ;;
  esac
}

confirm_scope_path() {
  local p="$1"
  if [[ -d "$p" ]]; then
    return 0
  fi
  if [[ -e "$p" ]]; then
    yesno "Path exists but is not a directory: $p. Use anyway?" default_no
  else
    yesno "Path does not exist: $p. Use anyway?" default_no
  fi
}

_ppicker_browse_dir() {
  local start
  ask_var start "Start browsing from" "$HOME"
  start="${start:-$HOME}"
  if [[ ! -d "$start" ]]; then
    print -r -- "${RED}Not a directory: $start${RESET}"
    return 1
  fi
  local _fd; _fd="$(fd_cmd 2>/dev/null)"
  if [[ -n "$_fd" ]]; then
    "$_fd" --type d --max-depth 5 . "$start" 2>/dev/null \
      | fzf --prompt="Pick dir> " --preview="ls '{}'" --height=40% --no-sort
  else
    find "$start" -type d -maxdepth 5 2>/dev/null \
      | fzf --prompt="Pick dir> " --preview="ls '{}'" --height=40% --no-sort
  fi
}

_ppicker_search_dir() {
  local root term
  ask_var root "Search under directory" "$HOME"
  root="${root:-$HOME}"
  if [[ ! -d "$root" ]]; then
    print -r -- "${RED}Not a directory: $root${RESET}"
    return 1
  fi
  ask_var term "Directory name contains" ""
  [[ -z "$term" ]] && return 1
  local -a matches=()
  while IFS= read -r _d; do [[ -n "$_d" ]] && matches+=("$_d"); done \
    < <(find "$root" -type d -maxdepth 6 -iname "*${term}*" 2>/dev/null | sort)
  if (( ${#matches[@]} == 0 )); then
    print -r -- "${YELLOW}No matches for '$term' under $root.${RESET}"
    return 1
  fi
  local pick
  select_one_var pick "Select directory" "${matches[@]}"
  [[ -n "$pick" ]] && print -r -- "$pick"
}

choose_scope_paths() {
  local key="$1"; shift
  local -a path_suggestions; path_suggestions=("$@")
  reply=()
  local -A seen_paths
  local add_more=1

  while (( add_more )); do
    local chosen_path=""
    local -a menu=()
    (( ${#path_suggestions[@]} )) && menu+=("${path_suggestions[@]}")
    menu+=("Search by name")
    have fzf && menu+=("Browse filesystem (fzf)")
    menu+=("Enter path manually")

    print -r -- "${CYAN}Pick a path for scope '$key':${RESET}"
    local pick; select_one_var pick "Select a path" "${menu[@]}"

    if [[ -z "$pick" || "$pick" == "Enter path manually" ]]; then
      ask_var manual "Enter absolute path (Tab to complete)" ""
      [[ -n "$manual" ]] && chosen_path="$(expand_path "$manual")"
    elif [[ "$pick" == "Search by name" ]]; then
      chosen_path="$(_ppicker_search_dir)"
    elif [[ "$pick" == "Browse filesystem (fzf)" ]]; then
      chosen_path="$(_ppicker_browse_dir)"
    else
      chosen_path="$pick"
    fi

    if [[ -z "$chosen_path" ]]; then
      print -r -- "${RED}No path provided.${RESET}"
    elif [[ -n "${seen_paths[$chosen_path]:-}" ]]; then
      print -r -- "${YELLOW}Path already added: ${chosen_path}${RESET}"
    elif confirm_scope_path "$chosen_path"; then
      reply+=("$chosen_path")
      seen_paths[$chosen_path]=1
      print -r -- "${GREEN}✔ Path: ${chosen_path}${RESET}"
    fi

    (( ${#reply[@]} )) || continue
    yesno "Add another path to this scope?" default_no || add_more=0
  done
}

# ----------------------------- INIT (Wizard) ----------------------------------
cmd_init() {
  local _init_mode="${1:-}"
  if [[ "$_init_mode" == "--defaults" ]]; then
    local ttl="$DEFAULT_CACHE_TTL_MIN"
    local label="${PPICKER_SCOPE_LABEL:-work}"
    local path="${PPICKER_SCOPE_PATH:-$HOME/work}"
    local editor="$DEFAULT_EDITOR"
    local depth="$DEFAULT_DEPTH"
    local excludes_arr; excludes_arr=$(array_to_toml "DEFAULT_EXCLUDES[@]")
    local incws="$DEFAULT_INCLUDE_WS"
  if have mkdir; then command mkdir -p "$CONFIG_DIR"; fi
    {
      print -r -- "[global]"
      print -r -- "cache_ttl_min = ${ttl}"
      print -r -- ""
      print -r -- "[scopes.work]"
      print -r -- "label = \"${label}\""
      print -r -- "paths = [\"${path}\"]"
      print -r -- "editor = \"${editor}\""
      print -r -- "depth = ${depth}"
      print -r -- "excludes = ${excludes_arr}"
      print -r -- "include_workspaces = ${incws}"
      print -r -- ""
    } >| "$CONFIG_FILE"
    print -r -- "Non-interactive config written: $CONFIG_FILE"
    return 0
  fi
  local BOLD=$'\e[1m' RESET=$'\e[0m' CYAN=$'\e[36m' YELLOW=$'\e[33m' GREEN=$'\e[32m' RED=$'\e[31m' UNDER=$'\e[4m'
  # Enable tab-completion for path inputs via vared
  autoload -Uz compinit && compinit -u 2>/dev/null
  # Silence xtrace to avoid noisy debug output during wizard; restore on exit
  setopt localoptions typesetsilent  # make option changes local to this function
  local __had_xtrace=0
  if [[ -o xtrace ]]; then __had_xtrace=1; unsetopt xtrace; fi
  print -r -- "${BOLD}${CYAN}🖥️ Project Picker Setup Wizard${RESET}"
  print -r -- "${YELLOW}Config path:${RESET} ${UNDER}$CONFIG_FILE${RESET}"
  if have mkdir; then command mkdir -p "$CONFIG_DIR"; fi

  local ttl

  print -r -- "${BOLD}Cache TTL${RESET} (min): How long to cache results. Default: ${CYAN}$DEFAULT_CACHE_TTL_MIN${RESET}"
  while true; do
    ask_var ttl "Cache TTL (min)" "$DEFAULT_CACHE_TTL_MIN"
    [[ -z "$ttl" ]] && ttl="$DEFAULT_CACHE_TTL_MIN"
    if is_positive_integer "$ttl"; then
      break
    fi
    print -r -- "${RED}Cache TTL must be a positive integer.${RESET}"
  done
  print -r -- "${GREEN}✔ TTL: $ttl min${RESET}"

  # No global editor/preview/depth/excludes/include_ws prompts — rely on plugin defaults.

  # Scopes loop
  print -r -- "${BOLD}${CYAN}Add Project Scopes${RESET}"
  print -r -- "${BOLD}Scope${RESET}: For each scope enter: key → label → editor → one or more paths."
  print -r -- "Enter 'q' at scope key to finish."
  local -a scope_keys scope_labels scope_editors scope_depths scope_excludes scope_incws scope_paths
  local -a path_suggestions; path_suggestions=($(suggest_paths))

  while true; do
    print -r -- "${BOLD}${GREEN}New Scope${RESET}"
    ask_var rawk "Scope key (shortcut, e.g. w, p, pr, pt; q to finish)" ""
    [[ "$rawk" == q || "$rawk" == Q ]] && { break; }
    local key; key=$(normalize_key "$rawk")
    while [[ -z "$key" ]]; do
      print -r -- "${RED}Key cannot be empty.${RESET}"
      ask_var rawk "Scope key (shortcut, e.g. w, p, pr, pt; q to finish)" ""
      [[ "$rawk" == q || "$rawk" == Q ]] && { break 2; }
      key=$(normalize_key "$rawk")
    done
    if is_reserved_scope_key "$key"; then
      print -r -- "${RED}Key '$key' is reserved for a built-in command.${RESET}"
      continue
    fi
    
    validate_key_unique "$key" "scope_keys[@]" || { print -r -- "${RED}Key '$key' already added.${RESET}"; continue; }
    print -r -- "${GREEN}✔ Scope key: $key${RESET}"

  ask_var label "Scope label (display name)" "$key"
    print -r -- "${GREEN}✔ Scope label: $label${RESET}"
  local chosen_editor
  local -a __scope_editor_opts=("code" "codium" "idea" "cursor" "windsurf" "nvim" "vim" "custom:/absolute/path/to/editor")
  select_one_var chosen_editor "Scope editor" "${__scope_editor_opts[@]}"
  [[ -z "$chosen_editor" ]] && chosen_editor="$DEFAULT_EDITOR"
    print -r -- "${GREEN}✔ Scope editor: $chosen_editor${RESET}"

    choose_scope_paths "$key" "${path_suggestions[@]}"
    local -a chosen_paths; chosen_paths=("${reply[@]}")
    (( ${#chosen_paths[@]} )) || { print -r -- "${RED}No paths provided; skipping scope '$key'.${RESET}"; continue; }
    local chosen_path="${(j.:.)chosen_paths}"

  while true; do
    ask_var d "Depth (blank=default)" ""
    [[ -z "$d" ]] && break
    is_positive_integer "$d" && break
    print -r -- "${RED}Depth must be a positive integer or blank.${RESET}"
  done
  if [[ -n "$d" ]]; then print -r -- "${GREEN}✔ Depth: ${d}${RESET}"; else print -r -- "${GREEN}✔ Depth: default${RESET}"; fi
  local exclude_default="default"
  local -a detected_all=()
  local _scope_path
  for _scope_path in "${chosen_paths[@]}"; do
    detect_exclude_presets "$_scope_path"
    detected_all+=("${reply[@]}")
  done
  if (( ${#detected_all[@]} )); then
    local -A detected_seen
    local -a detected_unique=()
    local _preset
    for _preset in "${detected_all[@]}"; do
      (( ${+detected_seen[$_preset]} )) && continue
      detected_seen[$_preset]=1
      detected_unique+=("$_preset")
    done
    reply=("${detected_unique[@]}")
  else
    reply=()
  fi
  if (( ${#reply[@]} )); then
    local detected_presets="${(j:,:)reply}"
    exclude_default="default,${detected_presets}"
    print -r -- "${CYAN}Detected project types: ${detected_presets}${RESET}"
    print -r -- "${CYAN}Suggested exclude presets: ${exclude_default}${RESET}"
  fi
  choose_excludes "$exclude_default"
  local exl
  if [[ "${reply[1]:-}" == "__PPICKER_EXCLUDES_NONE__" ]]; then
    exl="__PPICKER_EXCLUDES_NONE__"
    print -r -- "${GREEN}✔ Excludes: none${RESET}"
  elif (( ${#reply[@]} )); then
    exl="${(j:,:)reply}"
    print -r -- "${GREEN}✔ Excludes: ${exl}${RESET}"
  else
    exl=""
    print -r -- "${GREEN}✔ Excludes: default${RESET}"
  fi
  local iw
  if yesno "Include .code-workspace for this scope? (blank=default)" default_no; then
    iw="true"
  else
    iw="false"
  fi
  print -r -- "${GREEN}✔ Include workspaces: ${iw}${RESET}"

    scope_keys+="$key"
    scope_labels+="$label"
    scope_editors+="$chosen_editor"
  scope_paths+="$chosen_path"
    scope_depths+="$d"
    scope_excludes+="$exl"
    scope_incws+="$iw"

  # Add another scope? Use 'q' at scope key to finish.
  done

  (( ${#scope_keys[@]} )) || die "No scopes configured; aborting."

  # Show summary before writing
  print -r -- ""
  print -r -- "${BOLD}${CYAN}Summary of Configuration${RESET}"
  print -r -- "${YELLOW}Global:${RESET}"
  print -r -- "  cache_ttl_min = $ttl"

  print -r -- "${YELLOW}Scopes:${RESET}"
  local i=1
  while (( i <= ${#scope_keys[@]} )); do
    local summary_excludes="${scope_excludes[$i]}"
    [[ "$summary_excludes" == "__PPICKER_EXCLUDES_NONE__" ]] && summary_excludes="none"
    [[ -z "$summary_excludes" ]] && summary_excludes="default"
    local summary_depth="${scope_depths[$i]:-default}"
    local summary_ws="${scope_incws[$i]:-default}"
    local summary_paths="${scope_paths[$i]//:/, }"
    print -r -- "  [${scope_keys[$i]}] label='${scope_labels[$i]}', editor='${scope_editors[$i]}', paths='${summary_paths}', depth='${summary_depth}', include_workspaces='${summary_ws}', excludes='${summary_excludes}'"
    ((i++))
  done

  # Confirm before writing
  if [[ -f "$CONFIG_FILE" ]]; then
    yesno "${RED}Config file exists. Overwrite?${RESET}" default_no || { print -r -- "${RED}Aborted.${RESET}"; return 1; }
  fi

  # Write TOML
  {
  print -r -- "[global]"
  print -r -- "cache_ttl_min = ${ttl}"
    print -r -- ""

    local i=1
    while (( i <= ${#scope_keys[@]} )); do
      local k="${scope_keys[$i]}"
      local lbl="${scope_labels[$i]}"
      local ed="${scope_editors[$i]}"
      local paths_colon="${scope_paths[$i]}"
  local -a paths_a; IFS=':' read -rA paths_a <<< "$paths_colon"
  local paths_arr; paths_arr=$(array_to_toml "paths_a[@]")

      print -r -- "[scopes.${k}]"
      print -r -- "label = \"${lbl}\""
      print -r -- "paths = ${paths_arr}"
      print -r -- "editor = \"${ed}\""

      local d="${scope_depths[$i]}"; [[ -n "$d" ]] && print -r -- "depth = ${d}"
      local ex="${scope_excludes[$i]}"
      if [[ "$ex" == "__PPICKER_EXCLUDES_NONE__" ]]; then
        print -r -- "excludes = []"
      elif [[ -n "$ex" ]]; then
  local -a ex_a; IFS=',' read -rA ex_a <<< "$ex"
  local ex_arr; ex_arr=$(array_to_toml "ex_a[@]")
        print -r -- "excludes = ${ex_arr}"
      fi
  local iw="${scope_incws[$i]}"; [[ -n "$iw" ]] && print -r -- "include_workspaces = ${iw}"

      print -r -- ""
      ((i++))
    done
  } >| "$CONFIG_FILE"

  print -r -- "${GREEN}Config written: $CONFIG_FILE${RESET}"
  print -r -- "${CYAN}Next: run 'p --reload' to apply changes, or 'p --doctor' to verify.${RESET}"
  # Restore xtrace if it was enabled
  if (( __had_xtrace )); then setopt xtrace; fi
}

# ----------------------------- DOCTOR -----------------------------------------
parse_toml_scopes() {
  # Echo lines: key|label|paths_colon|editor|depth|excludes_colon|include_ws
  [[ -f "$CONFIG_FILE" ]] || return 0
  local section="" line
    setopt localoptions typesetsilent
    unsetopt xtrace verbose
  local k label editor depth excludes include_ws paths_raw
  while IFS= read -r line; do
    line="$(_pp_strip_toml_comment "$line")"
    [[ -z "${line//[[:space:]]/}" ]] && continue
    if [[ "$line" == \[*\] ]]; then
      if [[ -n "$k" ]]; then
        print -r -- "${k}|${label}|${paths_raw}|${editor}|${depth}|${excludes}|${include_ws}"
      fi
      section="${line#\[}"; section="${section%\]}"
      k=""; label=""; editor=""; depth=""; excludes=""; include_ws=""; paths_raw=""
      [[ "$section" == scopes.* ]] && k="${section#scopes.}"
      continue
    fi

    if [[ "$section" == scopes.* && "$line" == *"="* ]]; then
      local kk="${line%%=*}"; kk="${kk//[[:space:]]/}"
      local vv="${line#*=}"; vv="${vv##[[:space:]]}"
      case "$kk" in
        label)   label="$(_pp_unquote_toml "$vv")" ;;
        editor)  editor="$(_pp_unquote_toml "$vv")" ;;
        depth)   depth="${vv//[[:space:]]/}" ;;
        include_workspaces) include_ws="${vv//[[:space:]]/}" ;;
        excludes)
          local raw="${vv#\[}"; raw="${raw%\]}"
          local -a _de=()
          while IFS= read -r _tok; do [[ -n "$_tok" ]] && _de+=("$_tok"); done < <(_pp_parse_toml_array "$raw")
          excludes="${(j.:.)_de}"
          ;;
        paths)
          local raw="${vv#\[}"; raw="${raw%\]}"
          local -a _dp=()
          while IFS= read -r _tok; do [[ -n "$_tok" ]] && _dp+=("$_tok"); done < <(_pp_parse_toml_array "$raw")
          paths_raw="${(j.:.)_dp}"
          ;;
      esac
    fi
  done < "$CONFIG_FILE"
  if [[ -n "$k" ]]; then
    print -r -- "${k}|${label}|${paths_raw}|${editor}|${depth}|${excludes}|${include_ws}"
  fi
}

doctor_deps() {
  local ok=1
  local fd_bin fd_path

  note "Optional dependencies:"
  if fd_bin="$(fd_cmd)"; then
    fd_path="$(cmd_path "$fd_bin")"
    note "  project discovery: found ${fd_bin}${fd_path:+ at $fd_path} (used to build picker lists)"
  else
    note "  project discovery: fd/fdfind missing (falls back to find)"
    ok=0
  fi
  if have fzf; then
    note "  picker UI: found fzf at $(cmd_path fzf) (uses fzf selector)"
  else
    note "  picker UI: fzf missing (falls back to built-in TUI/menu)"
    ok=0
  fi
  if have tree; then
    note "  preview: found tree at $(cmd_path tree) (uses tree preview)"
  else
    note "  preview: tree missing (preview is disabled/limited)"
    ok=0
  fi
  (( ok )) && note "All optional dependencies available."
}

doctor_config() {
  emulate -L zsh
  setopt localoptions typesetsilent
  unsetopt xtrace verbose
  set +x +v 2>/dev/null || true
  if [[ ! -f "$CONFIG_FILE" ]]; then
    err "No config file at $CONFIG_FILE"
    note "Run: p --config"
    return 1
  fi
  note "Config: $CONFIG_FILE"
  local any=0
  local error_found=0
  local __xfd __xtracefd_saved
  exec {__xfd}>/dev/null
  __xtracefd_saved="$XTRACEFD"
  XTRACEFD=$__xfd
  while IFS='|' read -r key label paths_colon editor depth excludes include_ws; do
    emulate -L zsh
    setopt localoptions typesetsilent
    unsetopt xtrace verbose
    set +x +v 2>/dev/null || true
    any=1
    [[ -z "$key" ]] && continue
    note "— Scope '${key}' (${label:-$key})"
    note "   editor: ${editor:-$DEFAULT_EDITOR}  depth: ${depth:-$DEFAULT_DEPTH}  include_ws: ${include_ws:-$DEFAULT_INCLUDE_WS}"
    note "   excludes: ${${excludes//:/, }:-${(j:,:)DEFAULT_EXCLUDES}}"
    (
      emulate -L zsh
      setopt localoptions typesetsilent
      unsetopt xtrace verbose
      set +x +v 2>/dev/null || true
      local -a ps; IFS=':' read -rA ps <<< "$paths_colon"
      local _path
      for _path in "${ps[@]}"; do
        local _expanded; _expanded=$(expand_path "$_path" 2>/dev/null)
        if [[ -z "$_expanded" ]]; then
          err "   ! path not set: '$_path'"
          error_found=1
        elif [[ "$_expanded" != /* && "$_expanded" != "~/"* ]]; then
          err "   ! path not absolute: '$_path' (expanded: '$_expanded')"
          error_found=1
        elif [[ ! -d "$_expanded" ]]; then
          err "   ! missing directory: '$_expanded' (from '$_path')"
          error_found=1
        else
          note "   ✓ $_expanded"
        fi
      done
    )
  done < <(parse_toml_scopes)
  # Restore xtrace fd
  if [[ -n "$__xtracefd_saved" ]]; then XTRACEFD="$__xtracefd_saved"; else unset XTRACEFD; fi
  exec {__xfd}>&-
  if (( error_found )); then
    err "Config check failed: see errors above."
    return 2
  fi
}

# ----------------------------- DOCTOR (Wrapper) ------------------------------
cmd_doctor() {
  local rc=0
  doctor_deps || true
  if ! doctor_config; then
    rc=$?
  fi
  return $rc
}

# ----------------------------- HELP / VERSION ---------------------------------
print_help() {
  cat <<EOF
ppicker ${VERSION}

Usage:
  ppicker init          Interactive wizard to create ${CONFIG_FILE}
  ppicker doctor        Validate config and show dependency fallbacks
  ppicker reload        Backend reload guidance for scripts (run 'p --reload' in your shell to refresh plugin)
  ppicker --help        Show this help
  ppicker --version     Show version
EOF
}

print_version() { print -r -- "$VERSION"; }

# ----------------------------- Reload ----------------------------------------
cmd_reload() {
  print -r -- "Reloading config: $CONFIG_FILE"
  # Touch plugin file to trigger re-source in shell (if sourced via .zshrc)
  if [[ -f "$CONFIG_FILE" ]]; then
    print -r -- "Config exists. To reload plugin functions, re-source your plugin:"
    print -r -- "  source /path/to/project-picker/project-picker.plugin.zsh"
    print -r -- "Or restart your shell."
  else
    print -r -- "No config found at $CONFIG_FILE. Run 'ppicker init' first."
  fi
}

# ----------------------------- Main -------------------------------------------
main() {
  local sub="${1:-}"
  case "$sub" in
    init)    shift; cmd_init "$@";;
    doctor)  shift; cmd_doctor "$@";;
    reload)  shift; cmd_reload "$@";;
    --help|-h) print_help;;
    --version|-v) print_version;;
    *) print_help; [[ -n "$sub" ]] && exit 1 || exit 0;;
  esac
}
main "$@"
